Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rt2", "=", " ", 
  RowBox[{"ContourPlot3D", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", "-", 
         RowBox[{"radius", "/", 
          RowBox[{"Cos", "[", "\[Tau]p", "]"}]}]}], ")"}], "^", "2"}], "+", 
      RowBox[{
       RowBox[{"(", "y", ")"}], "^", "2"}]}], "==", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"radius", " ", 
        RowBox[{"Tan", "[", "\[Tau]p", "]"}]}], ")"}], "^", "2"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "limit"}], ",", "limit"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", 
      RowBox[{"-", "limit"}], ",", "limit"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", 
      RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
    RowBox[{"ContourStyle", "->", 
     RowBox[{"{", 
      RowBox[{"Black", ",", 
       RowBox[{"Opacity", "[", "0.5", "]"}]}], "}"}]}], ",", " ", 
    RowBox[{"Mesh", "->", "None"}], ",", 
    RowBox[{"BoxRatios", "->", "Automatic"}]}], "]"}]}]], "Input",
