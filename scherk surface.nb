Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Tau]", " ", "=", " ", 
   RowBox[{"Pi", "/", "8"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Tau]p", " ", "=", " ", 
   RowBox[{"ArcCos", "[", 
    RowBox[{"30", "/", "radius"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", "[", 
   RowBox[{"r_", ",", "t_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"16", " ", 
       RowBox[{"Cos", "[", "\[Tau]", "]"}]}], ")"}]}], ")"}], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Log", "[", 
      FractionBox[
       RowBox[{"1", "+", 
        SuperscriptBox["r", "2"], "+", 
        RowBox[{"2", " ", "r", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"t", " ", "-", "\[Tau]"}], "]"}]}]}], 
       RowBox[{"1", "+", 
        SuperscriptBox["r", "2"], "-", 
        RowBox[{"2", " ", "r", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"t", "-", "\[Tau]"}], "]"}]}]}]], "]"}], "  ", "+", " ", 
     RowBox[{"Log", "[", 
      FractionBox[
       RowBox[{"1", "+", 
        SuperscriptBox["r", "2"], "+", 
        RowBox[{"2", " ", "r", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"t", " ", "+", "\[Tau]"}], "]"}]}]}], 
       RowBox[{"1", "+", 
        SuperscriptBox["r", "2"], "-", 
        RowBox[{"2", " ", "r", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"t", "+", "\[Tau]"}], "]"}]}]}]], "]"}]}], " ", 
    ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y", "[", 
   RowBox[{"r_", ",", "t_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"16", " ", 
       RowBox[{"Sin", "[", "\[Tau]", "]"}]}], ")"}]}], ")"}], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Log", "[", 
       FractionBox[
        RowBox[{"1", "+", 
         SuperscriptBox["r", "2"], "+", 
         RowBox[{"2", " ", "r", " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"t", " ", "-", "\[Tau]"}], "]"}]}]}], 
        RowBox[{"1", "+", 
         SuperscriptBox["r", "2"], "-", 
         RowBox[{"2", " ", "r", " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"t", "-", "\[Tau]"}], "]"}]}]}]], "]"}]}], "  ", "+", " ", 
     
     RowBox[{"Log", "[", 
      FractionBox[
       RowBox[{"1", "+", 
        SuperscriptBox["r", "2"], "+", 
        RowBox[{"2", " ", "r", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"t", " ", "+", "\[Tau]"}], "]"}]}]}], 
       RowBox[{"1", "+", 
        SuperscriptBox["r", "2"], "-", 
        RowBox[{"2", " ", "r", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"t", "+", "\[Tau]"}], "]"}]}]}]], "]"}]}], " ", 
    ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"v", "[", 
   RowBox[{"r_", ",", "t_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"8", " ", 
       RowBox[{"Sin", "[", "\[Tau]", "]"}], 
       RowBox[{"Cos", "[", "\[Tau]", "]"}]}], ")"}]}], ")"}], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"ArcTan", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Sin", "[", 
          RowBox[{"4", "\[Tau]"}], "]"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"r", "^", "2"}], " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"2", 
            RowBox[{"(", 
             RowBox[{"t", "-", "\[Tau]"}], ")"}]}], "]"}]}], "-", 
         RowBox[{
          RowBox[{"r", "^", "2"}], 
          RowBox[{"Sin", "[", 
           RowBox[{"2", 
            RowBox[{"(", 
             RowBox[{"t", "+", "\[Tau]"}], ")"}]}], "]"}]}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"r", "^", "4"}], " ", "+", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"4", " ", "\[Tau]"}], "]"}], "-", 
         RowBox[{
          RowBox[{"r", "^", "2"}], " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"2", 
            RowBox[{"(", 
             RowBox[{"t", "-", "\[Tau]"}], ")"}]}], "]"}]}], "-", 
         RowBox[{
          RowBox[{"r", "^", "2"}], " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"2", 
            RowBox[{"(", 
             RowBox[{"t", "+", "\[Tau]"}], ")"}]}], "]"}]}]}], ")"}]}], "]"}],
      "-", 
     RowBox[{"4", "\[Tau]"}]}], ")"}]}]}]}], "Input",
