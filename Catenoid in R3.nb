        FractionBox[
         RowBox[{
          RowBox[{"-", "2"}], "-", 
          RowBox[{"2", " ", 
           SuperscriptBox["P0", "2"]}]}], 
         RowBox[{"P0", " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"2", " ", 
