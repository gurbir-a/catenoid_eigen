Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Log", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{"a", "[", "s", "]"}], "]"}], "]"}], "/.", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"a", "[", "start", "]"}], "==", "bc1"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"a", "'"}], "[", "start", "]"}], "==", "bc2"}], ",", " ", 
          
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"scalarLaplacian", "[", 
              RowBox[{"a", "[", "\[Sigma]", "]"}], "]"}]}], " ", "-", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"2", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  SuperscriptBox["P0", "2"], "+", 
                  SuperscriptBox["P0", "4"]}], ")"}], "/", 
                SuperscriptBox["\[Sigma]", "4"]}]}], ")"}], "*", 
             RowBox[{"a", "[", "\[Sigma]", "]"}]}]}], " ", "==", 
           RowBox[{"\[Lambda]", " ", 
            RowBox[{"a", "[", "\[Sigma]", "]"}]}]}]}], " ", "}"}], ",", "a", 
        ",", 
        RowBox[{"{", 
         RowBox[{"\[Sigma]", ",", "start", ",", "2000"}], "}"}]}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], " ", ")"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"s", ",", "start", ",", "1500"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1200", ",", "1500"}], "}"}], ",", "Automatic"}], "}"}]}]}], 
  "]"}]], "Input",
