         RowBox[{"1", "+", 
          RowBox[{"2", " ", 
           SuperscriptBox["P0", "2"]}]}]], "+", 
        FractionBox[
         RowBox[{"0.000016666666666666695`", " ", 
          RowBox[{"(", 
           RowBox[{"10", "+", 
            RowBox[{"34", " ", 
             SuperscriptBox["P0", "2"]}], "+", 
            RowBox[{"24", " ", 
